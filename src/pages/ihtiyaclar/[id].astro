---
import Layout from '../../layouts/Layout.astro';
import NeedDetail from '../../components/app/NeedDetail';
import { Loading } from '../../components/ui/primitives';

const { id = '' } = Astro.params;
---

<Layout title="İhtiyaç" description="İhtiyaç Kanvası, çözülebilirlik denetimi ve açıklanabilir aday eşleşmesi.">
  <NeedDetail client:only="react" id={id}><Loading slot="fallback" /></NeedDetail>
</Layout>
