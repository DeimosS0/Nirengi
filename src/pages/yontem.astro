---
import App from '../layouts/App.astro';
import Fold from '../components/method/Fold.astro';
import Sec from '../components/method/Sec.astro';
import Niri from '../components/ui/Niri';
import { Bar } from '../components/ui/kit';
import { Bolt, CheckCircle, Clipboard, Compass, Face, Flag, Flame, Mark, Shield } from '../components/ui/icons';
import { LEVEL_NAME, LevelGlyph } from '../components/ui/primitives';
import { LEVELS } from '../lib/labels.ts';
import { WEIGHTS, NEUTRAL } from '../lib/engine/match.ts';
import { assessCanvas, PUBLISH_THRESHOLD } from '../lib/engine/canvas.ts';
import { DEMOTE, PROMOTE, TIERS, XP } from '../lib/engine/progress.ts';
import { SILENCE_DAYS } from '../lib/store.ts';

const checks = assessCanvas({ current: '', pain: '', painMetric: '', outcome: '', criteria: [], constraints: [], decisionMaker: '', scope: '' }, []).checks;
const f = (n: number) => n.toLocaleString('tr-TR');
const pct = (n: number) => `%${Math.round(n * 100)}`;

const jump = [
  ['merdiven', 'Doğrulama'],
  ['eslesme', 'Eşleşme'],
  ['kanvas', 'İhtiyaç'],
  ['defter', 'Defter'],
  ['ilerleme', 'İlerleme'],
  ['adalet', 'Adalet'],
  ['veri', 'Gerçek mi, demo mu?'],
];

const levelTone = { S1: '--ink-4', S2: '--cyan', S3: '--indigo' } as const;

const parts = [
  { k: 'Kanıt yakınlığı', w: WEIGHTS.evidence, d: 'İhtiyacın istediği her alan için kişinin en güçlü işinin ağırlığı alınır; aynı alanda her ek doğrulanmış iş +0,1 ekler (en fazla 1). Sonra alanların ortalaması bulunur.', tone: 'indigo' },
  { k: 'Bağlam uyumu', w: WEIGHTS.context, d: `Başlangıç ${f(NEUTRAL)} (nötr). Kurumun sektöründe doğrulanmış iş +0,35, aynı ölçekte doğrulanmış iş +0,25.`, tone: 'cyan' },
  { k: 'Kapasite', w: WEIGHTS.capacity, d: 'Pilota açık 1, kısmen müsait 0,6, şu an kapalı 0,15.', tone: 'green' },
  { k: 'İş birliği geçmişi', w: WEIGHTS.history, d: `Başlangıç ${f(NEUTRAL)} (nötr). Başarıyla kapanan her pilot +0,35, çift onaylı her aşama +0,15; kalan aralık üzerinden eklenir.`, tone: 'purple' },
] as const;

const xpRows = [
  ['GitHub’da üretim yaptığın gün', XP.activeDay],
  ['Yeni doğrulanan bir iş', XP.evidence],
  ['Kurumun onayladığı bir aşama', XP.milestone],
  ['Toplulukla paylaşım (günde bir kez)', XP.post],
  ['Paylaşımının aldığı her destek', XP.support],
  ['Soran kişinin “işe yaradı” dediği cevap', XP.helpful],
] as const;

const goals = [
  [1, 'Rahat', 'Okul ya da iş yoğunken.'],
  [3, 'Düzenli', 'Çoğu kişi için sürdürülebilir tempo.'],
  [5, 'Yoğun', 'Bir şeyi hızla büyütürken.'],
] as const;

const fairness = [
  ['Yaş, okul, takipçi skora girmez.', 'Bu alanlar eşleşme motoruna hiç verilmez.'],
  ['Kör keşif varsayılandır.', 'Kurum ilk temasa kadar isim, yaş, okul ve şehir görmez; yalnızca işi görür.'],
  ['Geçmişi olmayan cezalandırılmaz.', 'Bağlam ve geçmiş sıfırdan değil, nötr değerden başlar.'],
  ['Tek bir güven puanı yok.', 'Kişiler değil, iddialar doğrulanır.'],
  ['Başarısızlık da kayıttır.', 'Gerekçesiyle kapanan pilotun onaylı aşamaları kanıt olarak kalır.'],
];

const truth = [
  ['GitHub hesap sahipliği', 'Gerçek', 'GitHub API; bio ya da gist’e eklenen tek kullanımlık kod.'],
  ['Alan adı sahipliği', 'Gerçek', 'DNS TXT kaydı; Google ve Cloudflare DoH üzerinden.'],
  ['Eşleşme, kanvas puanı, takım önerisi', 'Gerçek', 'Bu sayfadaki formüllerle, her görüntülemede yeniden hesaplanır.'],
  ['Defter bütünlüğü', 'Gerçek', 'SHA-256 hash zinciri; doğrulama her kaydı yeniden hesaplar.'],
  ['Taslak motoru', 'Kural tabanlı', 'Çevrim dışı çalışır; üretimde aynı arayüzün arkasına dil modeli konabilir.'],
  ['Kurumlar, kişiler, lig arkadaşları, S3 tasdikleri', 'Kurgusal', 'Demo ekosistemi; gerçek kurum hesaplarıyla değişecek.'],
  ['Kalıcılık', 'Tarayıcı', 'Demo verisi localStorage’da tutulur; üretimde Cloudflare D1 planlı.'],
] as const;
const truthTone: Record<string, string> = { Gerçek: 'bg-green-tint text-green-lip', 'Kural tabanlı': 'bg-cyan-tint text-cyan-lip', Kurgusal: 'bg-bg-3 text-ink-2', Tarayıcı: 'bg-bg-3 text-ink-2' };
---

<App
  title="Yöntem"
  mode="auto"
  description="nirengi sayıları nasıl hesaplar: doğrulama basamakları, eşleşme formülü, yayın eşiği, defter, haftalık ilerleme, XP ve ligler."
>
  <div class="mx-auto max-w-[680px]">
    <div class="flex items-end gap-3">
      <Niri mood="think" size={92} />
      <div class="relative mb-4 flex-1 rounded-[18px] border-2 border-line bg-bg px-4 py-3">
        <span class="absolute -left-[9px] bottom-4 h-4 w-4 rotate-45 border-b-2 border-l-2 border-line bg-bg" aria-hidden="true"></span>
        <h1 class="text-[20px] font-black leading-tight text-ink">Her sayı nereden geliyor?</h1>
        <p class="mt-0.5 text-[15px] font-bold text-ink-3">Ekranda gördüğün her sayı kurallarla hesaplanır. Kurallar burada, kod açık.</p>
      </div>
    </div>

    <nav class="mt-4 flex flex-wrap gap-2" aria-label="Bölümler">
      {jump.map(([id, label]) => <a href={`#${id}`} class="chip transition-colors hover:border-indigo/40 hover:text-indigo">{label}</a>)}
    </nav>

    <Sec id="merdiven" title="Doğrulama: üç basamak" lead="Her iş üç basamaktan birinde durur. Basamak, işin bir eşleşmeye katabileceği en yüksek ağırlığı belirler.">
      <span slot="icon"><CheckCircle size={36} /></span>
      {
        (['S1', 'S2', 'S3'] as const).map((k) => (
          <div class="card flex items-start gap-4 p-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-bg-2">
              <LevelGlyph level={k} size={28} />
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-[17px] font-black text-ink">{LEVEL_NAME[k]}</p>
                <span class="chip mono !text-[12px]">{LEVELS[k].code}{LEVELS[k].name !== LEVEL_NAME[k] && ` · ${LEVELS[k].name}`}</span>
              </div>
              <p class="mt-1 text-[15px] font-bold text-ink-3">{LEVELS[k].blurb}</p>
              <div class="mt-3 flex items-center gap-3">
                <div class="h-3 flex-1 overflow-hidden rounded-full bg-bg-3">
                  <div class="h-full rounded-full" style={`width:${LEVELS[k].weight * 100}%;background:rgb(var(${levelTone[k]}))`}></div>
                </div>
                <span class="num shrink-0 text-[14px] font-extrabold text-ink-2">ağırlık {f(LEVELS[k].weight)}</span>
              </div>
            </div>
          </div>
        ))
      }
      <Fold title="Kopya eser" aside="ağırlık 0">
        <p>Aynı eseri daha güçlü doğrulamayla sahiplenen biri varsa diğer iddia işaretlenir ve eşleşmede sayılmaz. Doğrulanabilir sahip, eseri kendi adına tutar.</p>
      </Fold>
      <Fold title="İtiraz altında" aside="ağırlık ÷ 2">
        <p>Bir iş için gerekçeli itiraz kayda geçer ve herkese açıktır. İnceleme sürerken işin ağırlığı yarıya iner; itiraz geri çekilirse eski ağırlığına döner.</p>
      </Fold>
    </Sec>

    <Sec id="eslesme" title="Eşleşme: dört parça" lead="Bir kişinin bir ihtiyaca uyumu 0–100 arası bir sayıdır. Hep aynı dört parçadan çıkar; ekranda “Neden?” dediğin yerde bu parçaları görürsün.">
      <span slot="icon"><Compass size={36} /></span>
      <div class="card p-4">
        <div class="flex h-5 gap-1 overflow-hidden rounded-full" role="img" aria-label="Dört parçanın puandaki payı">
          {parts.map((p) => <span class="h-full rounded-full" style={`flex:${p.w};background:rgb(var(--${p.tone}))`}></span>)}
        </div>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[13px] font-extrabold text-ink-3">
          {parts.map((p) => (
            <li class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full" style={`background:rgb(var(--${p.tone}))`}></span>
              {p.k}
            </li>
          ))}
        </ul>
        <p class="mono mt-4 break-words rounded-[12px] bg-bg-2 px-3 py-2 text-[13px] font-bold text-ink-2">
          puan = 100 × ({f(WEIGHTS.evidence)}·Kanıt + {f(WEIGHTS.context)}·Bağlam + {f(WEIGHTS.capacity)}·Kapasite + {f(WEIGHTS.history)}·Geçmiş)
        </p>
      </div>
      {parts.map((p) => (
        <Fold title={p.k} aside={pct(p.w)}>
          <p>{p.d}</p>
        </Fold>
      ))}
      <Fold title="Eksik kanıt geri bildirimi">
        <p>Doğrulanmış işi olmayan her alan için “buraya bir doğrulanmış iş eklenseydi puan kaç olurdu” yeniden hesaplanır ve aday için kazanç olarak gösterilir.</p>
      </Fold>
      <Fold title="Takım önerisi">
        <p>Alan yüzeyindeki açıkların en çoğunu kapatan kişiyi ekleyen açgözlü bir küme örtüsü; en fazla 3 kişi.</p>
      </Fold>
      <Fold title="Yükselen sinyal">
        <p>Son 90 gündeki ağırlıklı iş, önceki 9 ayın çeyreklik ortalamasının en az 1,5 katıysa kişi yükselen sinyal taşır.</p>
      </Fold>
    </Sec>

    <Sec id="kanvas" title="İhtiyaç ve yayın eşiği" lead={`Kurum sorununu yedi alanlı bir kanvasa yazar. Kanvas kendini 100 üzerinden puanlar; yayın için en az ${PUBLISH_THRESHOLD} puan ve sıfır engel gerekir.`}>
      <span slot="icon"><Clipboard size={36} /></span>
      <div class="card p-4">
        <div class="flex items-center justify-between gap-3">
          <p class="text-[16px] font-black text-ink">Yayın eşiği</p>
          <span class="num text-[18px] font-black text-green-lip">{PUBLISH_THRESHOLD}/100</span>
        </div>
        <div class="relative mt-3">
          <Bar value={PUBLISH_THRESHOLD / 100} tone="green" h={16} />
          <span class="absolute inset-y-[-4px] w-1 rounded-full bg-ink" style={`left:calc(${PUBLISH_THRESHOLD}% - 2px)`} aria-hidden="true"></span>
        </div>
      </div>
      <Fold title="Puan nasıl dağılıyor?">
        <ul class="divide-y-2 divide-line">
          {
            checks.map((c) => (
              <li class="flex items-center gap-3 py-2">
                <span class="min-w-0 flex-1">{c.label}</span>
                {c.blocking && <span class="pill bg-red-tint !py-0.5 text-red-lip">engel</span>}
                <span class="num w-8 shrink-0 text-right font-extrabold text-ink">{c.points}</span>
              </li>
            ))
          }
        </ul>
      </Fold>
      <Fold title="Ölçülebilir kriter ne demek?">
        <p>Bir eşik değeri (sayı, yüzde) ya da somut bir teslim içerir: “teslim edilir”, “belgelenir” gibi. “Daha iyi olsun” gibi cümleler eşiği geçemez.</p>
      </Fold>
    </Sec>

    <Sec id="defter" title="Defter: kırılmaz kayıt" lead="Pilotta olan her şey deftere yazılır. Kayıtlar düzenlenmez, yalnızca eklenir.">
      <span slot="icon"><Flag size={36} /></span>
      <div class="card flex items-center justify-between gap-1.5 p-4" aria-hidden="true">
        {
          [1, 2, 3].map((n, i) => (
            <>
              <span class="flex-1 rounded-[14px] border-2 border-line bg-bg-2 px-2 py-3 text-center text-[13px] font-extrabold text-ink-2">Kayıt {n}</span>
              {i < 2 && (
                <svg width="18" height="12" viewBox="0 0 18 12" class="shrink-0 text-indigo">
                  <path d="M1 6h14M11 1.5 15.5 6 11 10.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </>
          ))
        }
      </div>
      <Fold title="Zincir nasıl çalışıyor?">
        <p>Her kayıt <span class="mono text-[13px]">SHA-256(önceki özet | zaman | taraf | tür | metin)</span> ile mühürlenir. Geçmişte tek harf değişirse o kayıttan sonraki bütün özetler tutmaz; doğrulama her kaydı yeniden hesaplayıp bunu yakalar.</p>
      </Fold>
      <Fold title="Çift onay">
        <p>Bir aşama, iki taraf da onaylamadan tamamlanmaz. Onaylanan aşama, gencin profiline Kurum onaylı bir kanıt olarak işlenir.</p>
      </Fold>
      <Fold title="Sessizlik göstergesi" aside={`${SILENCE_DAYS} gün`}>
        <p>{SILENCE_DAYS} gün boyunca güncelleme gelmezse iki tarafa da uyarı düşer; pilot sessizce ölmez.</p>
      </Fold>
    </Sec>

    <Sec id="ilerleme" title="İlerleme, XP ve ligler" lead="Seri, kaç gün üretim yaptığına bakar; kaç commit attığına değil. XP yalnızca doğrulanabilir olaylardan gelir.">
      <span slot="icon"><Flame size={36} /></span>
      <Fold title="Haftalık ilerleme nasıl sayılıyor?" open>
        <p>Hafta Pazartesi’den Pazar’a sürer. Bir gün; GitHub’da üretim yaptığında, işin doğrulandığında, bir görevi bitirdiğinde ya da cevabın işe yaradığında sayılır. Paylaşım ve destek XP verir ama haftalık hedefe sayılmaz.</p>
        <p>Hedefini sen seçersin. Seri, hedefini tutturduğun ardışık hafta sayısıdır; mola haftası seriyi ne bozar ne artırır.</p>
        <ul class="mt-1 space-y-2">
          {
            goals.map(([g, name, text]) => (
              <li class="flex items-center gap-3 rounded-[14px] bg-bg-2 px-3 py-2">
                <span class="num grid h-8 w-8 shrink-0 place-items-center rounded-full bg-indigo text-[15px] font-black text-white">{g}</span>
                <span><b class="text-ink">{name}</b> · haftada {g} gün. {text}</span>
              </li>
            ))
          }
        </ul>
      </Fold>
      <Fold title="XP nereden geliyor?" aside={`günde en çok ${XP.dailyCap}`}>
        <ul class="divide-y-2 divide-line">
          {
            xpRows.map(([label, v]) => (
              <li class="flex items-center gap-3 py-2">
                <span class="min-w-0 flex-1">{label}</span>
                <span class="num flex shrink-0 items-center gap-1 font-black text-gold-ink">
                  <Bolt size={18} /> +{v}
                </span>
              </li>
            ))
          }
        </ul>
        <p>Görevler kendi XP’sini taşır; değeri görev kartında yazar. Bir günde en fazla {XP.dailyCap} XP sayılır: kimse bir haftayı tek gecede geçemez.</p>
      </Fold>
      <Fold title="Ligler nasıl işliyor?" aside={`${TIERS.length} lig`}>
        <ol class="grid grid-cols-5 gap-1 text-center" aria-label="Ligler">
          {
            TIERS.map((t, i) => (
              <li class="flex flex-col items-center gap-1">
                <Shield size={44} tier={i} />
                <span class="text-[13px] font-extrabold text-ink">{t}</span>
              </li>
            ))
          }
        </ol>
        <p>Benzer seviyedeki kişilerle aynı ligde yarışırsın ve haftalık XP’ne göre sıralanırsın. İlk {PROMOTE} sıra yükselme bölgesidir; son {DEMOTE} sıra düşme bölgesidir. En alt ligde düşme, en üst ligde yükselme yoktur.</p>
        <p>Lig arkadaşları kurgusal demo verisidir.</p>
      </Fold>
    </Sec>

    <Sec id="adalet" title="Adalet ilkeleri" lead="Eşleşme, kimin kim olduğuna değil, ne yaptığına bakar.">
      <span slot="icon"><Face size={36} /></span>
      <ul class="card divide-y-2 divide-line">
        {
          fairness.map(([t, d]) => (
            <li class="flex items-start gap-3 p-4">
              <CheckCircle size={26} />
              <p class="text-[15px] font-semibold text-ink-3"><b class="text-ink">{t}</b> {d}</p>
            </li>
          ))
        }
      </ul>
    </Sec>

    <Sec id="veri" title="Gerçek mi, demo mu?" lead="Neyin gerçekten çalıştığı, neyin temsilî olduğu açık olsun.">
      <span slot="icon"><Mark size={36} /></span>
      <ul class="card divide-y-2 divide-line">
        {
          truth.map(([k, v, d]) => (
            <li class="p-4">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-[15px] font-black text-ink">{k}</p>
                <span class={`pill !py-0.5 ${truthTone[v]}`}>{v}</span>
              </div>
              <p class="mt-1 text-[14px] font-bold text-ink-3">{d}</p>
            </li>
          ))
        }
      </ul>
      <p class="px-1 text-[14px] font-bold text-ink-3">Gizlilik: demo hiçbir kişisel veriyi sunucuya göndermez. GitHub ve DNS sorguları doğrudan tarayıcından ilgili servislere gider.</p>
    </Sec>
  </div>
</App>
