---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/landing/Hero.astro';
import Feature from '../components/landing/Feature.astro';
import Stairs from '../components/landing/Stairs.astro';
import Community from '../components/landing/Community.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import LiveWeek from '../components/landing/LiveWeek';
import LiveMatch from '../components/landing/LiveMatch';

export const prerender = true;
---

<Layout title="nirengi · Yaptığın işle fark edil" description="Gençlerin yaptığı doğrulanmış işi, kurumların yazdığı ihtiyaçlarla buluşturan açık kaynak web hizmeti. Özgeçmiş yok, iş var.">
  <Hero />

  <Feature
    id="hafta"
    tone="orange"
    heading="Her gün değil, *her hafta* üret."
    body="Haftada 1, 3 ya da 5 gün hedef seç. Üretim yaptığın gün sayılır, commit sayısı değil. Hedefi tutturdukça serin hafta hafta büyür; mola haftası serini bozmaz."
    more={{ href: '/yontem#ilerleme', label: 'İlerleme nasıl sayılıyor?' }}
  >
    <LiveWeek client:only="react"><div slot="fallback" class="card h-[300px]"></div></LiveWeek>
  </Feature>

  <Feature
    id="dogrulama"
    tone="cyan"
    reverse
    heading="Söyleneni değil, *doğrulananı* göster."
    body="Her iş üç basamaktan birinde durur: Beyan, Doğrulandı, Kurum onaylı. GitHub hesabın ya da alan adın senin olduğunda iş doğrulanır; birlikte çalıştığın kurum onayladığında en üste çıkar."
    more={{ href: '/yontem#merdiven', label: 'Ağırlıklar nasıl işliyor?' }}
  >
    <Stairs />
  </Feature>

  <Feature
    id="eslesme"
    tone="indigo"
    heading="İhtiyaç yazılır, eşleşme *gerekçesiyle* gelir."
    body="Kurum çözmek istediği sorunu yazar. Adaylar dört nedenle puanlanır ve her puanın bir “Neden?” ekranı vardır. Pilot açılınca her aşama iki tarafın onayıyla deftere yazılır."
    more={{ href: '/yontem#eslesme', label: 'Puan nasıl hesaplanıyor?' }}
  >
    <LiveMatch client:only="react"><div slot="fallback" class="card h-[330px]"></div></LiveMatch>
  </Feature>

  <Feature
    id="topluluk"
    tone="purple"
    reverse
    heading="Yalnız değilsin, birbirinize *destek* olun."
    body="Takıldığın yeri toplulukta sor, bildiğini paylaş; işe yarayan cevabın XP kazandırır. Açık kaynakta görev al, PR’ın birleşince işin doğrulanır."
  >
    <Community />
  </Feature>

  <FinalCta />
</Layout>
