---
// First screen: Niri, one friendly sentence, two stacked keys.
import Niri from '../ui/Niri';
import { Building, CheckCircle, Flame, Shield } from '../ui/icons';

const stickers = [
  { label: 'Haftalık seri', pos: 'left-0 top-6', delay: '0s' },
  { label: 'Doğrulandı', pos: 'right-0 top-[72px]', delay: '0.7s' },
  { label: 'Lig', pos: 'left-3 bottom-10', delay: '1.3s' },
  { label: 'Kurum onaylı', pos: 'right-0 bottom-3', delay: '0.4s' },
];
---

<section class="mx-auto max-w-[1120px] px-4 pb-12 pt-6 sm:px-6 lg:pb-24 lg:pt-14" aria-labelledby="hero-title">
  <div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
    <div class="relative mx-auto h-[290px] w-full max-w-[420px] sm:h-[380px]">
      <div class="absolute inset-x-8 bottom-3 top-5 rounded-[48%] bg-indigo-tint sm:inset-x-12"></div>
      <div class="absolute inset-0 grid place-items-center pt-4">
        <div class="rise">
          <Niri mood="wave" size={240} className="!h-[190px] !w-[190px] sm:!h-[250px] sm:!w-[250px]" />
        </div>
      </div>
      {
        stickers.map((s) => (
          <span
            class={`niri-bob absolute flex items-center gap-2 rounded-full border-2 border-line bg-bg py-1.5 pl-2 pr-3.5 text-[14px] font-black text-ink shadow-[0_4px_0_rgb(var(--line))] ${s.pos}`}
            style={`animation-delay:${s.delay}`}
          >
            {s.label === 'Haftalık seri' && <Flame size={24} />}
            {s.label === 'Doğrulandı' && <CheckCircle size={24} />}
            {s.label === 'Lig' && <Shield size={24} tier={2} />}
            {s.label === 'Kurum onaylı' && <Building size={24} />}
            {s.label}
          </span>
        ))
      }
    </div>

    <div class="text-center lg:text-left">
      <h1 id="hero-title" class="h-hero">Yaptığın işle <span class="text-indigo">fark edil.</span></h1>
      <p class="lead mx-auto mt-4 max-w-[36ch] lg:mx-0">
        Gençlerin yaptığı doğrulanmış işi, kurumların yazdığı ihtiyaçlarla buluşturuyoruz. Özgeçmiş yok, iş var.
      </p>
      <div class="mx-auto mt-8 flex max-w-[380px] flex-col gap-3 lg:mx-0">
        <a href="/bugun" class="btn-primary btn-lg btn-block">Genç olarak başla</a>
        <a href="/kurum" class="btn-line btn-lg btn-block">Kurum olarak ihtiyaç yaz</a>
      </div>
      <p class="mt-4 text-[14px] font-bold text-ink-3">Kayıt gerekmez. Demo verisi bu tarayıcıda kalır.</p>
    </div>
  </div>
</section>
