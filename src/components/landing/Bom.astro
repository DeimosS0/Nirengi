---
// Bill of materials, revision plan, success metrics and team, as engineering documents.
const bom = [
  { part: 'Astro', role: 'Sayfa iskeleti ve sunucu', lic: 'MIT' },
  { part: 'React', role: 'Etkileşimli ekranlar', lic: 'MIT' },
  { part: 'Tailwind CSS', role: 'Token tabanlı stil', lic: 'MIT' },
  { part: 'Motion', role: 'Ekran geçişleri', lic: 'MIT' },
  { part: 'Lucide', role: 'İkonlar', lic: 'ISC' },
  { part: 'Archivo · JetBrains Mono', role: 'Yazı karakterleri, pakete gömülü', lic: 'OFL-1.1' },
  { part: 'SHA-256 defter', role: 'Bağımlılıksız, kendi uygulamamız', lic: 'açık' },
];
const revs = [
  { m: 'Ay 1', t: 'Kalıcı altyapı', d: 'Cloudflare Workers + D1 + R2 + KV, GitHub OAuth, kurum hesapları.' },
  { m: 'Ay 2', t: 'Doğrulayıcılar', d: 'npm, mağazalar, DOI/Crossref, Behance/Figma; kurumsal S3 imzası.' },
  { m: 'Ay 3', t: 'Gerçek ihtiyaç turu', d: 'GİRVAK ve Zemin360 kurumlarıyla ilk tur.' },
  { m: 'Ay 4', t: 'Açık standartlar', d: 'Açık API, Open Badges 3.0 / W3C VC dışa aktarımı.' },
];
const metrics = [
  { name: 'Eşleşme isabeti', def: 'Önerilen ilk 3 adaydan pilota dönüşenlerin oranı.' },
  { name: 'Pilot tamamlanma', def: 'Sessizce terk edilmeden, gerekçesiyle kapanan pilotlar.' },
  { name: 'İlk fırsata erişim', def: 'İlk kanıttan ilk pilota geçen gün sayısı.' },
  { name: '90 günlük canlılık', def: 'Son 90 günde etkileşim üreten ilişkilerin oranı.' },
];
const works = [
  { name: 'Makine Launcher', d: 'On binlerce kullanıcıya ulaşan masaüstü yazılımı' },
  { name: 'SCFramework', d: 'Kendi geliştirdiğimiz yerli oyun motoru' },
  { name: 'Teliqos SDK', d: 'Yayımlanmış geliştirici kiti' },
  { name: 'CEDRA Brain', d: 'Kod tabanlarını bilgi grafiğine dönüştüren altyapı' },
];
---

<section class="wrap pt-24 md:pt-32" id="etki" aria-labelledby="bom-title">
  <div>
    <h2 id="bom-title" class="display max-w-[14ch] text-[clamp(34px,4.4vw,60px)]">Bugün çalışıyor. Dört ayda kalıcı.</h2>
    <p class="mt-5 max-w-[62ch] text-[16px] leading-relaxed text-ink-2">
      Her parça açık lisanslı ve paket içinde; sahnede internet kesilse de arayüz çalışır. Kod, yöntem ve formüller açıktır. Başarımızı da kanıtla ölçeceğiz.
    </p>
  </div>

  <div class="mt-10 grid gap-4 lg:grid-cols-2">
    <article class="overflow-hidden rounded-[6px] border border-line-2 bg-raised">
      <h3 class="border-b border-line px-4 py-3 text-[16px] font-bold">Malzeme listesi</h3>
      <table class="w-full text-left text-[14px]">
        <thead class="bg-sunken">
          <tr>
            <th class="plabel px-4 py-2 font-semibold">Bileşen</th>
            <th class="plabel px-4 py-2 font-semibold">Görev</th>
            <th class="plabel px-4 py-2 text-right font-semibold">Lisans</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {bom.map((b) => (
            <tr>
              <td class="px-4 py-2 font-semibold">{b.part}</td>
              <td class="px-4 py-2 text-ink-2">{b.role}</td>
              <td class="num px-4 py-2 text-right text-[12.5px] text-ink-3">{b.lic}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </article>

    <article class="overflow-hidden rounded-[6px] border border-line-2 bg-raised" id="yol-haritasi">
      <h3 class="border-b border-line px-4 py-3 text-[16px] font-bold">Revizyon planı · GİRVAK süreci</h3>
      <ol class="divide-y divide-line">
        <li class="grid grid-cols-[4.5rem_1fr] gap-3 px-4 py-3 text-[14px]">
          <span class="plabel pt-1 !text-[rgb(var(--s3))]">Şimdi</span>
          <div>
            <p class="font-semibold">Hackathon prototipi</p>
            <p class="mt-0.5 text-ink-2">Tam döngü, gerçek GitHub ve DNS doğrulaması, birim testli motor. Veri tarayıcıda.</p>
          </div>
        </li>
        {revs.map((r) => (
          <li class="grid grid-cols-[4.5rem_1fr] gap-3 px-4 py-3 text-[14px]">
            <span class="plabel pt-1">{r.m}</span>
            <div>
              <p class="font-semibold">{r.t}</p>
              <p class="mt-0.5 text-ink-2">{r.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </article>

    <article class="overflow-hidden rounded-[6px] border border-line-2 bg-raised">
      <h3 class="border-b border-line px-4 py-3 text-[16px] font-bold">Başarı ölçütleri</h3>
      <dl class="grid gap-px bg-line sm:grid-cols-2">
        {metrics.map((m) => (
          <div class="bg-raised px-4 py-3">
            <dt class="text-[14.5px] font-semibold">{m.name}</dt>
            <dd class="mt-0.5 text-[13.5px] text-ink-2">{m.def}</dd>
          </div>
        ))}
      </dl>
    </article>

    <article class="overflow-hidden rounded-[6px] border border-line-2 bg-raised" id="ekip">
      <h3 class="border-b border-line px-4 py-3 text-[16px] font-bold">Ekip · bu problemi içinden yaşadık</h3>
      <p class="px-4 pt-3 text-[14px] leading-relaxed text-ink-2">
        Ekosisteme yaşımızla değil ürettiğimizle girdik. Ekip, ürünün savunduğu kompozisyonun aynısı: ürün ve teknoloji, proje yönetimi ve veri, görsel tasarım ve deneyim.
      </p>
      <ul class="mt-3 grid gap-px border-t border-line bg-line sm:grid-cols-2">
        {works.map((w) => (
          <li class="bg-raised px-4 py-3">
            <p class="text-[14.5px] font-semibold">{w.name}</p>
            <p class="mt-0.5 text-[13px] text-ink-2">{w.d}</p>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>
