---
// Closing band: solid colour, a compass on a white stage (Niri already greets in the hero), the same two keys again.
import { Compass } from '../ui/icons';
---

<section class="border-t-2 border-line bg-indigo" aria-labelledby="cta-title">
  <div class="mx-auto flex max-w-[1040px] flex-col items-center gap-8 px-4 py-14 text-center sm:px-6 lg:flex-row lg:gap-16 lg:py-20 lg:text-left">
    <div class="grid h-[190px] w-[190px] shrink-0 place-items-center rounded-full bg-white sm:h-[220px] sm:w-[220px]" style="box-shadow:0 6px 0 rgb(255 255 255 / 0.4)">
      <Compass size={150} />
    </div>
    <div class="w-full">
      <h2 id="cta-title" class="text-[clamp(28px,3.6vw,40px)] font-black leading-[1.12] tracking-[-0.02em] !text-white">Küçük bir adımla başla.</h2>
      <p class="mx-auto mt-3 max-w-[40ch] text-[17px] font-bold text-white/85 lg:mx-0">Kayıt yok. Kurgusal kurumlar ve kişilerle bütün döngüyü bir oturumda dene.</p>
      <div class="mx-auto mt-7 flex max-w-[380px] flex-col gap-3 lg:mx-0 lg:max-w-none lg:flex-row">
        <a
          href="/bugun"
          class="btn-lg inline-flex min-h-[54px] items-center justify-center rounded-[14px] bg-white px-7 text-[16px] font-black uppercase tracking-[0.06em] text-indigo transition-transform duration-100 active:translate-y-1"
          style="box-shadow:0 4px 0 rgb(255 255 255 / 0.45)"
        >
          Genç olarak başla
        </a>
        <a
          href="/kurum"
          class="inline-flex min-h-[54px] items-center justify-center rounded-[14px] border-2 border-white/60 px-7 text-[16px] font-black uppercase tracking-[0.06em] text-white transition-colors hover:bg-white/10"
        >
          Kurum olarak ihtiyaç yaz
        </a>
      </div>
    </div>
  </div>
</section>
