---
// Notes pinned on a map: a question, a reply that worked, a quest. A dotted line
// runs through the pins like a survey line; the map carries a faint graticule.
import { Hand, Route } from '../ui/icons';
import { Tri } from '../ui/pafta';

const pin = 'absolute -left-[33px] top-3';
const note = 'rounded-[14px] border-2 border-line bg-bg px-4 py-3';
const lip = 'box-shadow:0 3px 0 rgb(var(--line))';
---

<svg class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
  <defs>
    <pattern id="graticule" width="28" height="28" patternUnits="userSpaceOnUse">
      <path d="M14 11v6M11 14h6" stroke="rgb(var(--line-2))" stroke-width="1.4" stroke-linecap="round" opacity="0.7"></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#graticule)"></rect>
</svg>

<div class="relative">
  <span class="absolute bottom-14 left-[13px] top-5 border-l-[3px] border-dotted border-purple/45" aria-hidden="true"></span>
  <ol class="space-y-5 pl-9">
    <li class="relative">
      <span class={pin} aria-hidden="true">
        <Tri size={24} tone="purple" state="done"><span class="block h-1.5 w-1.5 rounded-full bg-white"></span></Tri>
      </span>
      <div class={`${note} mr-6`} style={lip}>
        <p class="text-[15px] font-extrabold text-ink">Bu hatayı nasıl çözdün?</p>
        <span class="pill mt-2 bg-purple-tint !py-0.5 text-purple-lip">Soru</span>
      </div>
    </li>

    <li class="relative">
      <span class={pin} aria-hidden="true">
        <Tri size={24} tone="purple" state="done"><span class="block h-1.5 w-1.5 rounded-full bg-white"></span></Tri>
      </span>
      <div class={`${note} ml-4`} style={lip}>
        <p class="text-[15px] font-extrabold text-ink">Önce önbelleği temizle, sonra yeniden dene.</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <span class="pill bg-green-tint !py-0.5 text-green-lip">İşe yaradı</span>
          <span class="pill bg-bg-2 !py-0.5 text-ink-3"><Hand size={16} on /> Destek</span>
        </div>
      </div>
    </li>

    <li class="relative">
      <span class={pin} aria-hidden="true">
        <Tri size={24} tone="purple" state="done"><span class="block h-1.5 w-1.5 rounded-full bg-white"></span></Tri>
      </span>
      <div class={`${note} flex items-center gap-4 mr-2`} style={lip}>
        <Route size={44} />
        <div class="min-w-0">
          <p class="text-[16px] font-black text-ink">Açık kaynak görevi</p>
          <p class="text-[14px] font-semibold text-ink-3">PR’ın birleşince iş doğrulanır ve profiline yazılır.</p>
        </div>
      </div>
    </li>
  </ol>
  <p class="mt-4 pl-9 text-[13px] font-semibold text-ink-3">Örnek gönderiler.</p>
</div>
