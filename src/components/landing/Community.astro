---
// A drawn slice of the community: a question, a reply that worked, a quest.
import { Chest, Face, Hand } from '../ui/icons';
---

<div class="space-y-3">
  <div class="flex items-end gap-2">
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-indigo-tint"><Face size={26} /></span>
    <div class="rounded-[18px] rounded-bl-[6px] border-2 border-line bg-bg px-4 py-3">
      <p class="text-[15px] font-extrabold text-ink">Bu hatayı nasıl çözdün?</p>
      <span class="pill mt-2 bg-purple-tint !py-0.5 text-purple-lip">Soru</span>
    </div>
  </div>

  <div class="flex items-end justify-end gap-2">
    <div class="rounded-[18px] rounded-br-[6px] border-2 border-line bg-bg px-4 py-3">
      <p class="text-[15px] font-extrabold text-ink">Önce önbelleği temizle, sonra yeniden dene.</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <span class="pill bg-green-tint !py-0.5 text-green-lip">İşe yaradı</span>
        <span class="pill bg-bg-2 !py-0.5 text-ink-3"><Hand size={16} on /> Destek</span>
      </div>
    </div>
    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-cyan-tint"><Face size={26} /></span>
  </div>

  <div class="card flex items-center gap-4 p-4">
    <Chest size={48} open />
    <div class="min-w-0">
      <p class="text-[16px] font-black text-ink">Açık kaynak görevi</p>
      <p class="text-[14px] font-bold text-ink-3">PR’ın birleşince iş doğrulanır ve profiline yazılır.</p>
    </div>
  </div>
  <p class="px-1 text-[13px] font-bold text-ink-3">Örnek gönderiler.</p>
</div>
