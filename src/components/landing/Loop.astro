---
import { PUBLISH_THRESHOLD } from '../../lib/engine/canvas.ts';
import { WEIGHTS } from '../../lib/engine/match.ts';

const f2 = (n: number) => n.toLocaleString('tr-TR', { minimumFractionDigits: 2 });
const blocks = [
  { title: 'İhtiyaç Kanvası', d: 'Serbest metindeki şikâyet yedi alanlı kanvasa dönüşür.', href: '/ihtiyaclar/yeni' },
  { title: 'Yayın eşiği', d: `Çözülebilirlik ${PUBLISH_THRESHOLD} altındaysa yayın kilitli kalır.`, href: '/yontem#kanvas' },
  { title: 'Eşleşme', d: `${f2(WEIGHTS.evidence)} kanıt + ${f2(WEIGHTS.context)} bağlam + ${f2(WEIGHTS.capacity)} kapasite + ${f2(WEIGHTS.history)} geçmiş`, href: '/ihtiyaclar' },
  { title: 'Pilot Defteri', d: 'Başarı kriterleri kilometre taşı olur; hedef sonradan değişmez.', href: '/pilotlar' },
  { title: 'Çift onay', d: 'Kurum ve yetenek onaylamadan taş kapanmaz; kayıt zincire yazılır.', href: '/pilotlar' },
  { title: 'S3 kanıt', d: 'Onaylı taş, kişinin profiline kurum tasdiki olarak işlenir.', href: '/kesfet' },
];
---

<section class="wrap pt-24 md:pt-32" data-path aria-labelledby="loop-title">
  <div class="overflow-hidden rounded-[10px] border border-line-2 bg-raised shadow-[0_18px_40px_-28px_rgb(0_0_0/0.45)]">
    <div class="grid gap-4 p-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end md:p-8">
      <h2 id="loop-title" class="display text-[clamp(32px,4vw,54px)]">Sinyal yolu kendini besler.</h2>
      <p class="max-w-[52ch] text-[15.5px] leading-relaxed text-ink-2">
        Muğlak bir şikâyet ölçülebilir bir ihtiyaca, ihtiyaç gerekçeli bir eşleşmeye, eşleşme ölçülen bir pilota dönüşür. Pilotun çıktısı yeni kanıttır ve bir sonraki eşleşmeyi güçlendirir.
      </p>
    </div>

    <div class="px-2.5 pb-2.5 md:px-3 md:pb-3">
      <div class="screen rounded-[4px] p-4 shadow-[inset_0_0_0_1px_rgb(0_0_0/0.6),inset_0_2px_8px_rgb(0_0_0/0.5)] md:px-6 md:py-6">
        <!-- desktop: one wire, six nodes, feedback trace drawn at S3 weight above it -->
        <div class="hidden md:block">
          <div class="relative h-14" aria-hidden="true">
            <svg class="absolute inset-0 h-full w-full overflow-visible" preserveAspectRatio="none" viewBox="0 0 1200 56">
              <path d="M1100 56 V24 H500 V46" fill="none" stroke="rgb(var(--s3))" stroke-width="4" vector-effect="non-scaling-stroke"></path>
              <path d="M492 42 H508 L500 56Z" fill="rgb(var(--s3))"></path>
            </svg>
            <p class="absolute left-[66.6%] top-0 -translate-x-1/2 bg-[rgb(var(--paper))] px-2 text-[12px] font-semibold text-[rgb(var(--s3))]">geri besleme · S3 kanıt eşleşmeye girer</p>
          </div>
          <div class="relative h-5">
            <div class="absolute inset-x-[8.33%] top-1/2 h-[2px] -translate-y-1/2 bg-[rgb(var(--line-2))]">
              <div data-path-fill class="h-full origin-left bg-[rgb(var(--ch1))]" style="transform:scaleX(1)"></div>
            </div>
            {blocks.slice(1).map((_, i) => (
              <svg class="absolute top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 text-[rgb(var(--ch1))]" style={`left:${((i + 1) / 6) * 100}%`} viewBox="0 0 12 12" aria-hidden="true">
                <path d="M3 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8"></path>
              </svg>
            ))}
            <ol class="absolute inset-0 grid grid-cols-6">
              {blocks.map((_, i) => (
                <li data-path-node={i} class="grid place-items-center">
                  <span class="led !h-3.5 !w-3.5" style="--c: var(--ch1)"></span>
                </li>
              ))}
            </ol>
          </div>
          <ol class="mt-4 grid grid-cols-6 gap-4">
            {blocks.map((b) => (
              <li>
                <a href={b.href} class="group block text-center">
                  <span class="block text-[15px] font-bold leading-tight group-hover:underline">{b.title}</span>
                  <span class="mt-1.5 block text-[12.5px] leading-snug text-ink-2">{b.d}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>

        <!-- mobile: the same path read downwards -->
        <ol class="md:hidden">
          {blocks.map((b) => (
            <li class="relative border-l-2 border-[rgb(var(--ch1))] pb-5 pl-5 last:pb-1">
              <span class="led on absolute -left-[8px] top-1 !h-3.5 !w-3.5" style="--c: var(--ch1)"></span>
              <a href={b.href} class="block">
                <span class="block text-[15px] font-bold leading-tight">{b.title}</span>
                <span class="mt-1 block text-[13px] leading-snug text-ink-2">{b.d}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="mt-4 flex items-center gap-3 text-[12.5px] font-semibold text-[rgb(var(--s3))] md:hidden">
          <span class="h-1 w-8 shrink-0 bg-[rgb(var(--s3))]"></span>
          geri besleme · S3 kanıt eşleşmeye girer
        </p>
      </div>
    </div>
  </div>
</section>
