---
// The six hackathon problems as an instrument datasheet: what is measured, how, and where to see it working.
const rows = [
  { n: '01', problem: 'Genç yeteneklerin keşfi', measure: 'Takipçiden bağımsız üretim ivmesi', how: 'Kör keşif (isim, yaş, okul gizli) · problemle arama · yükselen sinyal', href: '/kesfet', route: '/kesfet' },
  { n: '02', problem: 'Profil ve portfolyo doğruluğu', measure: 'Her iddianın doğrulama seviyesi', how: 'S1/S2/S3 merdiveni · gerçek GitHub ve DNS TXT sınaması · kopya eser parmak izi · şeffaf itiraz', href: '/kanit-bagla', route: '/kanit-bagla' },
  { n: '03', problem: 'Kurum–kişi eşleşmesi', measure: 'Dört bileşenli, gerekçeli skor', how: 'Kanıt · bağlam · kapasite · geçmiş · eksik kanıt geri bildirimi · takım kompozisyonu', href: '/ihtiyaclar', route: '/ihtiyaclar/:id' },
  { n: '04', problem: 'Yaşayan bir ağ', measure: 'Son 90 günde etkileşen ilişki oranı', how: 'Olay akışı · bağlantı sağlığı · somut sebepli yeniden temas · çeyreklik ihtiyaç turu', href: '/nabiz', route: '/nabiz' },
  { n: '05', problem: 'İhtiyaçların net tanımı', measure: 'Çözülebilirlik skoru, yayın eşiği 70', how: 'Yedi alanlı kanvas · serbest metinden taslak · benzer ihtiyaç hafızası', href: '/ihtiyaclar/yeni', route: '/ihtiyaclar/yeni' },
  { n: '06', problem: 'Şeffaf iş birliği takibi', measure: 'Çift onaylı kilometre taşı, kırılmaz zincir', how: 'Kriterden doğan kilometre taşları · SHA-256 defter · sessizlik göstergesi · kamuya açık kart', href: '/pilotlar', route: '/pilotlar/:id' },
];
---

<section class="wrap pt-24 md:pt-32" aria-labelledby="spec-title">
  <h2 id="spec-title" class="display text-[clamp(34px,4.4vw,60px)]">Altı problem, altı ölçüm.</h2>

  <div class="mt-8 overflow-hidden rounded-[6px] border border-line-2 bg-raised">
    <div class="border-b border-line-2 px-4 py-3.5"><p class="max-w-[86ch] text-[15px] leading-relaxed text-ink-2">
      Zemin360’ın altı probleminin kök nedeni aynı: ortada güvenilir bir kanıt katmanı yok. NİRENGİ her birini ölçülebilir bir büyüklüğe bağlar ve her ölçümün çalışan bir ekranı vardır.
    </p></div>
    <div class="hidden grid-cols-[3.5rem_1.1fr_1.1fr_1.6fr_9rem] gap-4 border-b border-line-2 bg-sunken px-4 py-2 md:grid">
      <span class="plabel">No</span>
      <span class="plabel">Problem</span>
      <span class="plabel">Ölçülen büyüklük</span>
      <span class="plabel">Mekanizma</span>
      <span class="plabel">Ekran</span>
    </div>
    <ol>
      {rows.map((r) => (
        <li class="border-b border-line last:border-b-0">
          <a href={r.href} class="group grid gap-x-4 gap-y-1 px-4 py-4 transition-colors hover:bg-paper md:grid-cols-[3.5rem_1.1fr_1.1fr_1.6fr_9rem] md:items-baseline">
            <span class="num text-[13px] text-ink-3">{r.n}</span>
            <span class="text-[16px] font-bold">{r.problem}</span>
            <span class="text-[14.5px] font-semibold text-[rgb(var(--s3))]">{r.measure}</span>
            <span class="text-[14px] leading-snug text-ink-2">{r.how}</span>
            <span class="num text-[12.5px] text-ink-3 group-hover:text-ink group-hover:underline">{r.route}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
