---
// NİRENGİ mark: a survey triangle on an indigo tile, with the orange nirengi point.
interface Props {
  class?: string;
}
const { class: cls = 'h-8 w-8' } = Astro.props;
---

<svg viewBox="0 0 40 40" class={cls} aria-hidden="true">
  <rect width="40" height="40" rx="5" fill="#6451E7"></rect>
  <path d="M20 8.5 31.5 29.5h-23Z" fill="none" stroke="#fff" stroke-width="2.6" stroke-linejoin="round"></path>
  <path d="M20 8.5V29.5M8.5 29.5 20 22.5l11.5 7" stroke="#fff" stroke-width="1.2" opacity=".55" fill="none"></path>
  <circle cx="20" cy="22.5" r="3.6" fill="#F99400" stroke="#fff" stroke-width="1.4"></circle>
</svg>
